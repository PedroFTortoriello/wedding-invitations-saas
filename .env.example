# Supabase — copy to .env and fill with values from your project
# (Supabase Dashboard → Project Settings → API). NEVER commit the real .env.

# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret — used for privileged/admin operations, the AbacatePay
# webhook, and seeding. Must NEVER be exposed to the client or committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AbacatePay (the R$149,90 publishing fee), API v2. Server-only — never ship to the browser.
ABACATEPAY_API_KEY=your-abacatepay-api-key
# v2 cobra a partir de um PRODUTO. Opcional: se em branco, o app cria o produto
# automaticamente no 1º pagamento. Recomendado fixar o id (evita recriação):
#   node scripts/abacatepay-create-product.mjs
ABACATEPAY_PUBLISH_PRODUCT_ID=
# Opcional: sobrescrever a base da API (default já é v2).
# ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
# The secret you append to the webhook URL in the AbacatePay dashboard:
#   https://your-app/api/webhooks/abacatepay?webhookSecret=...
# Required — webhooks are rejected unless this matches.
ABACATEPAY_WEBHOOK_SECRET=a-long-random-secret
# Optional: enable the X-Webhook-Signature HMAC check by setting the signing key
# AbacatePay documents. Leave blank until you confirm the exact key + digest
# (base64 vs hex) on https://docs.abacatepay.com/pages/webhooks/security — a wrong
# value would reject real payments. The ?webhookSecret gate above is enough on its own.
ABACATEPAY_WEBHOOK_SIGNING_SECRET=

# Base URL pública. Usada nos redirects da AbacatePay E no redirect_uri do OAuth do
# Mercado Pago (precisa bater EXATAMENTE com a cadastrada na aplicação) e nos webhooks.
APP_URL=http://localhost:3000

# Mercado Pago — presentes no cartão. O casal conecta a PRÓPRIA conta por OAuth e a
# cobrança é criada com o token dele: o dinheiro cai direto na conta do casal e a
# plataforma nunca custodia valor. Server-only — nunca exponha ao browser.
# Credenciais da sua aplicação: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Cifra os tokens do casal no banco (AES-256-GCM). Gere com: openssl rand -hex 32
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
# "Assinatura secreta" do webhook (painel da aplicação → Webhooks). Obrigatória:
# notificação sem assinatura válida é recusada.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: taxa do cartão (%) usada no repasse ao convidado. Padrão: 4.99.
# Ela cobre a taxa de PROCESSAMENTO do MP. Os juros do parcelamento são pagos
# pelo convidado enquanto a conta do casal estiver no modo padrão do Mercado Pago
# ("parcelado comprador").
MERCADOPAGO_CARD_FEE_PERCENT=
# Opcional: máximo de parcelas oferecidas (1 a 12). Padrão: 12. Use 1 se preferir
# só à vista — aí o valor recebido pelo casal não depende da configuração de
# parcelamento da conta dele.
MERCADOPAGO_MAX_INSTALLMENTS=
# Ligue APENAS se você também ativou PKCE na aplicação do Mercado Pago
# (Detalhes da aplicação -> fluxo authorization code com PKCE). Os dois lados
# precisam combinar: MERCADOPAGO_PKCE=true
MERCADOPAGO_PKCE=
# Segredo do Vercel Cron (renovação dos tokens do Mercado Pago). Sem ele, a rota
# /api/cron/mercadopago-refresh recusa qualquer chamada.
CRON_SECRET=

# Medição (tráfego pago). Tudo opcional: sem os IDs, nada carrega. Pixel e GA4 só
# carregam depois do "Aceitar" no aviso de cookies (LGPD); nunca nos sites dos casais.
# Meta Pixel (Gerenciador de Eventos → Fontes de dados → ID do pixel, só números):
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API (mesmo pixel → Configurações → Gerar token de acesso). Server-only.
META_CAPI_ACCESS_TOKEN=
# Opcional, só para testar no Gerenciador de Eventos (aba "Testar eventos"):
META_CAPI_TEST_EVENT_CODE=
# Google Analytics 4 (Administrador → Fluxos de dados → ID da métrica, "G-XXXXXXX"):
NEXT_PUBLIC_GA_MEASUREMENT_ID=
