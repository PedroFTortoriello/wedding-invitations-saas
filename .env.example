# Supabase — copy to .env and fill with values from your project
# (Supabase Dashboard → Project Settings → API). NEVER commit the real .env.

# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret — used for privileged/admin operations, the AbacatePay
# webhook, and seeding. Must NEVER be exposed to the client or committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AbacatePay (the R$149,90 publishing fee). Server-only — never ship to the browser.
ABACATEPAY_API_KEY=your-abacatepay-api-key
# The secret you append to the webhook URL in the AbacatePay dashboard:
#   https://your-app/api/webhooks/abacatepay?webhookSecret=...
# Required — webhooks are rejected unless this matches.
ABACATEPAY_WEBHOOK_SECRET=a-long-random-secret
# Optional: enable the X-Webhook-Signature HMAC check by setting the signing key
# AbacatePay documents. Leave blank until you confirm the exact key + digest
# (base64 vs hex) on https://docs.abacatepay.com/pages/webhooks/security — a wrong
# value would reject real payments. The ?webhookSecret gate above is enough on its own.
ABACATEPAY_WEBHOOK_SIGNING_SECRET=

# Base URL for AbacatePay return/completion redirects (e.g. https://vows.com.br).
APP_URL=http://localhost:3000
