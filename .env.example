# Supabase — copy to .env and fill with values from your project
# (Supabase Dashboard → Project Settings → API). NEVER commit the real .env.

# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret — used for privileged/admin operations and seeding.
# Must NEVER be exposed to the client or committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
